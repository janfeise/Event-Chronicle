# =============================================================================
# Event Chronicle — 环境变量配置
#
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
# =============================================================================

# LLM 提供商 (openai / azure / 兼容 OpenAI 接口的服务)
LLM_PROVIDER=openai

# LLM API 地址（可替换为第三方兼容端点）
LLM_BASE_URL=https://api.openai.com/v1

# LLM API Key（必填）
LLM_API_KEY=sk-your-api-key-here

# 模型名称
LLM_MODEL=gpt-4o

# 可选：温度参数 (0–2)，默认 0
# LLM_TEMPERATURE=0

# 可选：最大输出 token 数
# LLM_MAX_TOKENS=4096

# 可选：请求超时时间 (ms)
# LLM_TIMEOUT=60000

# 可选：全局默认 event_id，用于 chronicle 数据文件的命名
# 未配置时，appendEvents 自动生成 event_{时间戳}.json
# CHRONICLE_EVENT_ID=my-chronicle

# 可选：累计新增 N 条事件后自动触发合并（默认 5）
# 设为 0 禁用自动合并
# CHRONICLE_MERGE_TRIGGER=5

# 可选：合并时发送给 LLM 的已有事件窗口大小（默认 20）
# CHRONICLE_MERGE_WINDOW=20
