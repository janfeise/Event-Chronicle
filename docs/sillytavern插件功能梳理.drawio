        <mxCell id="pHsnJnkB9i9o_4h52aza-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="1. 事件提取：达到阈值后调用Event api 提取事件" vertex="1">
