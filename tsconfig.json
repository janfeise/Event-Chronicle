{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "."
  },
  "include": [
    "index.ts",
    "sdk/**/*.ts",
    "core/**/*.ts",
    "config/**/*.ts",
    "types/**/*.ts",
    "prompts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "test", "data"]
}
